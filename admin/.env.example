# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard). Same project as the
# client site — see ../karisimbi-supabase/README.md for setup.
#
# The anon/public key is safe to expose in frontend code — admin write
# access is granted by being logged in (Supabase Auth), enforced by the RLS
# policies in ../karisimbi-supabase/migrations/0001_init.sql. Never put the
# service_role key in this file or in any frontend app.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
