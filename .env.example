# Copy this file to .env and fill in your Supabase project's values
# (Project Settings → API in the Supabase dashboard).
#
# The anon/public key is safe to expose in frontend code — access is
# restricted by the row-level security policies defined in
# ../karisimbi-supabase/migrations/0001_init.sql. Never put the
# service_role key in this file or in any frontend app.
#
# If these are left unset, the app falls back to the bundled placeholder
# content in src/data/ — useful for local development before a Supabase
# project exists.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
